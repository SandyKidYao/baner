{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baner",
  "version": "0.1.1",
  "identifier": "dev.baner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baner",
        "width": 960,
        "height": 720,
        "minWidth": 320,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENzc5QjI4Qzc0RDkyRDYKUldUV2trM0hLSnQzclhWZTFZTlg5TFUwNFdYYlVFT3VlemNZK0lPaGlyK3RCOVNYVmIrNWNXeGQK",
      "endpoints": [
        "https://github.com/SandyKidYao/baner/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
